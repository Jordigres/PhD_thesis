\glsdefs@newdocentry{lms}%
{%
name={Learning Management System (LMS)},%
sort={Learning Management System (LMS)},%
type={main},%
first={Learning Management System (LMS)},%
firstplural={Learning Management System (LMS)s},%
text={Learning Management System (LMS)},%
plural={Learning Management System (LMS)s},%
description={often also called course management system or virtual learning environment, is a web-based software system that assists teachers in managing courses and delivering lessons online. It helps in administration, tracking, and reporting of the learning process. An LMS usually has the following constituent components: content creation, organization, delivery, learner support interactions, assessment and grading, and management of the learning process.},%
descriptionplural={often also called course management system or virtual learning environment, is a web-based software system that assists teachers in managing courses and delivering lessons online. It helps in administration, tracking, and reporting of the learning process. An LMS usually has the following constituent components: content creation, organization, delivery, learner support interactions, assessment and grading, and management of the learning process.},%
