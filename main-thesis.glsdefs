\glsdefs@newdocentry{cl}%
{%
name={Collaborative Learning},%
sort={Collaborative Learning},%
type={main},%
first={Collaborative Learning},%
firstplural={Collaborative Learnings},%
text={Collaborative Learning},%
plural={Collaborative Learnings},%
description={term is also known as Federated Learning. The term Federated Learning was introduced by Google in 2016. This approach does a machine learning /deep learning model development based on multiple clients (users) connected to a global server. The clients store and keep samples locally, without data interchanging, for privacy protection and data efficiency. This decentralized concept fundamentally focuses on learning from heterogeneous datasets to acquire a global model shared by all clients. Instead of exchanging data, federated learning passes model parameters between global and local models.},%
descriptionplural={term is also known as Federated Learning. The term Federated Learning was introduced by Google in 2016. This approach does a machine learning /deep learning model development based on multiple clients (users) connected to a global server. The clients store and keep samples locally, without data interchanging, for privacy protection and data efficiency. This decentralized concept fundamentally focuses on learning from heterogeneous datasets to acquire a global model shared by all clients. Instead of exchanging data, federated learning passes model parameters between global and local models.},%
